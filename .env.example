# Sao chép thành .env.local (KHÔNG commit). Để trống hai biến Supabase = chạy dữ liệu giả (mock) để demo.
# Điền cả hai để bật backend Supabase thật.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nguồn dữ liệu: 'auto' (mặc định) dùng Supabase nếu có URL ở trên, ngược lại dùng mock.
# Đặt 'mock' để luôn dùng dữ liệu giả kể cả khi đã cấu hình Supabase (hữu ích khi demo UI).
VITE_DATA_SOURCE=auto
